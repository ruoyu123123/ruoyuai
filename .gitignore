# ============================================================
# 敏感凭证（严禁入库）
# ============================================================
.env
.env.local
.env.backup*
*.key
*.pem

# ============================================================
# 用户私人内容（每个用户的小说项目独立 Git，不进系统仓库）
# ============================================================
workspace/novels/*
!workspace/novels/README.md
!workspace/novels/.gitkeep

workspace/styles/*
!workspace/styles/README.md
!workspace/styles/.gitkeep

# ============================================================
# 第三方版权材料（参考小说原文 / 蒸馏中间产物 / 调研缓存）
# ============================================================
.research_cache/
_reference/
**/原文/
**/蒸馏进度/
**/对比报告/
**/复刻测试/
**/衔接分析/
**/参考书籍/

# 仓库根目录散落的参考小说原文（防止用户把 source .txt 误推上来）
/*.txt
!/*README*.txt
!/requirements.txt
!/requirements*.txt

# ============================================================
# Claude Code 运行时
# ============================================================
.claude/scheduled_tasks.lock
.claude/.cache/
.claude/.model_capabilities.json
.claude/settings.local.json

# plan_tracker / session_memory 运行时数据
core/claude-home/.plans/
core/claude-home/.sessions/

# GEPA Pareto 前沿运行时快照（v23 Layer 4）
core/claude-home/.gepa/

# ============================================================
# 临时文件 / 调试
# ============================================================
*.tmp
*.log
_tmp/
_tmp_*
.tmp_*
**/_tmp/
**/.tmp_*

# style_evaluator 散落的 LLM prompt
/sfs_report_llm_eval_prompt.txt

# 异常文件名
/--help

# ============================================================
# Python
# ============================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.venv/
venv/

# ============================================================
# Node
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================
# IDE / OS
# ============================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 压缩包 / 安装包
# ============================================================
*.7z
*.zip
*.tar.gz
*.rar
安装包/
ruoyu.7z
