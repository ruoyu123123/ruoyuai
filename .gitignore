# ============================================================
# 敏感凭证（严禁入库）
# ============================================================
.env
.env.*
!.env.example
.env.local
.env.backup*
*.key
*.pem
**/credentials.json
**/service-account*.json

# ============================================================
# 用户私人内容（每个用户的小说项目独立 Git，不进系统仓库）
# ============================================================
workspace/novels/*
!workspace/novels/README.md
!workspace/novels/.gitkeep

workspace/styles/*
!workspace/styles/README.md
!workspace/styles/.gitkeep

# 临时调研缓存（个人 · 不入库；已跟踪的历史报告除外，新文件一律忽略）
workspace/_temp_research/**
!workspace/_temp_research/sys_upgrade_20260619/R20_W9_FINAL_REPORT.md

# ============================================================
# 第三方版权材料（参考小说原文 / 蒸馏中间产物 / 调研缓存）
# ============================================================
.research_cache/
_reference/
**/原文/
**/蒸馏进度/
**/对比报告/
**/复刻测试/
**/衔接分析/
**/参考书籍/

# 仓库根目录散落的参考小说原文（防止用户把 source .txt 误推上来）
/*.txt
!/*README*.txt
!/requirements.txt
!/requirements*.txt

# Playwright / chrome-devtools MCP 浏览器自动化产物（console/page 快照·体积大·不入库）
.playwright-mcp/

# ============================================================
# Claude Code 运行时
# ============================================================
.claude/scheduled_tasks.lock
.claude/.cache/
.claude/.model_capabilities.json
.claude/settings.local.json

# plan_tracker / session_memory 运行时数据
core/claude-home/.plans/
core/claude-home/.sessions/

# 运行时自学习数据（MAPE-K · 2026-05-30 · incidents/self_heal_kb/circuit · 易变运行时日志不入库；
# 注：lessons/runtime_lessons.md 在 lessons/ 下仍入库作经验快照）
core/claude-home/runtime/

# GEPA Pareto 前沿运行时快照（v23 Layer 4）
core/claude-home/.gepa/

# ai_wrapper 二次复核产物（运行时透传样本）
*.ai_review.json

# ============================================================
# 临时文件 / 调试
# ============================================================
*.tmp
*.log
_tmp/
_tmp_*
.tmp_*
**/_tmp/
**/.tmp_*

# style_evaluator 散落的 LLM prompt
/sfs_report_llm_eval_prompt.txt

# 异常文件名
/--help

# ============================================================
# Python
# ============================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.venv/
venv/

# ============================================================
# Node
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================
# IDE / OS
# ============================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 压缩包 / 安装包
# ============================================================
*.7z
*.zip
*.tar.gz
*.rar
安装包/
ruoyu.7z

# 运行日志与运行时状态
logs/
/data_version.json

# triage band 运行时报告
workspace/novels/*/_数据库/triage_band_report.json

