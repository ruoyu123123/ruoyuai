# ============================================================
# Gen-Model 配置示例（生成内容由当前激活的 model 处理）
# ============================================================
# 复制此文件为 .env 并填入你的实际值

# 当前激活的 profile 名（必填，对应下方 GEN__<name>__* 字段）
GEN_MODEL_ACTIVE=my_profile

# Fallback 链（profile 名按序，逗号分隔；留空 = 无 fallback）
# 主 profile 429/timeout/5xx 时按链顺序尝试下一个 profile
GEN_MODEL_FALLBACK_CHAIN=

# ============================================================
# Profile 示例：my_profile（复制粘贴改名即可新增）
# ============================================================
GEN__my_profile__MODEL=deepseek-v4-pro
GEN__my_profile__BASE_URL=https://your-proxy.com/v1
GEN__my_profile__API_KEY=sk-your-key-here
GEN__my_profile__TEMPERATURE=0.8
# MAX_TOKENS 留空 → 从 .claude/.model_capabilities.json 取（model_probe 探测结果）
GEN__my_profile__MAX_TOKENS=

# ============================================================
# 模板：复制下面 5 行，<name> 改成你的 profile 名（如 kimi_official / glm_main / qwen_max 等）
# 填入对应 model 名、base_url、key 即可生效；OpenAI 兼容协议（90%+ 中转站/官方 API 兼容）
# 然后把上方 GEN_MODEL_ACTIVE 改为这个 <name> 即可切换
# 也可用 CLI：python core/scripts/gen_model.py add <name> 一键追加模板
# ============================================================
# GEN__<name>__MODEL=
# GEN__<name>__BASE_URL=
# GEN__<name>__API_KEY=
# GEN__<name>__TEMPERATURE=0.8
# GEN__<name>__MAX_TOKENS=

# ============================================================
# 真语义 embedding（可选 · 2026-05-30）
# ============================================================
# 不配 → 默认走 hash 假语义（兼容现状，RAG 历史检索/角色 voice 漂移精度有限）。
# 配了 → 自动启用真语义 embedding（提升 RAG 检索 + voice drift 准确度）。
# 切换后端后务必跑一次：python core/scripts/embedding_store.py "<项目路径>" rebuild （维度变了要重建缓存）。
#
# 方式 A（推荐·零新依赖）：通义 text-embedding-v4（OpenAI 兼容端点，复用已装的 openai 包）
# GEN_EMBED_ACTIVE=qwen
# GEN_EMBED__qwen__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# GEN_EMBED__qwen__API_KEY=sk-your-dashscope-key
# GEN_EMBED__qwen__MODEL=text-embedding-v4
# GEN_EMBED__qwen__DIM=1024
#
# 方式 B（离线·需装依赖）：本地 bge-small-zh（先 pip install sentence-transformers）
# 设环境变量 EMBED_BACKEND=local 即启用（首次会下载 ~95MB 模型）。
