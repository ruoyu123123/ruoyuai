{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ruoyuai.user_preferences.v21",
  "title": "用户偏好.json schema（v21 完整版）",
  "description": "用户偏好契约。当前创作链路固定为 cluster-first：/write -> /outline -> /cluster-write -> /cluster-save-state -> 走向卡 -> /export；本 schema 只保留用户偏好，章节只由 splitter 在输出层生成。",
  "type": "object",
  "properties": {
    "_meta": {
      "type": "object",
      "properties": {
        "wizard_completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "schema_version": {
          "type": "string",
          "default": "v21"
        },
        "user_id": {
          "type": "string"
        }
      }
    },
    "project_basics": {
      "type": "object",
      "description": "项目基础。规划层只记录系统运行档；叙事长度由 ME 触发节奏、用户涟漪选择、writer 自由发挥和 splitter 输出层自然形成。",
      "properties": {
        "writer_mode": {
          "type": "string",
          "enum": [
            "完整模式",
            "轻量模式"
          ],
          "default": "完整模式",
          "description": "系统运行档（完整/轻量），与正文 writer 模式不是同一字段。正文 writer 固定 freestyle，见 workflow_preferences[key=writer_mode]。"
        }
      },
      "additionalProperties": false
    },
    "workflow_preferences": {
      "type": "array",
      "description": "扁平 key/value 偏好条目数组。承载 cluster_density_profile / writer_mode(freestyle) / rhythm_profile，不承载章节或卷内配额。",
      "items": {
        "$ref": "#/$defs/workflow_preference_entry"
      }
    },
    "narrative_pacing": {
      "type": "object",
      "description": "Phase 7: 叙事节拍偏好（v21 R1.2 新加）",
      "properties": {
        "storyteller_profile": {
          "type": "string",
          "enum": [
            "cassandra",
            "phoebe",
            "randy"
          ],
          "default": "cassandra",
          "description": "cassandra=标准升压（传统长篇）/ phoebe=长间歇爽文 / randy=随机展开（脑洞）"
        },
        "setback_interval_clusters": {
          "type": "integer",
          "minimum": 2,
          "maximum": 15,
          "default": 4,
          "description": "主角受挫间隔，以 cluster 节奏估计。爽文=8-12 / 标准=4-6 / 黑深残=2-3"
        },
        "happy_vs_dark_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.6,
          "description": "win 场景/事件占比目标（0.8=爽文 / 0.5=平衡 / 0.3=悲剧）"
        },
        "hub_rhythm_targets": {
          "type": "object",
          "description": "Hub 节奏角色分布",
          "properties": {
            "depart": {
              "type": "number",
              "default": 0.2
            },
            "quest": {
              "type": "number",
              "default": 0.5
            },
            "return": {
              "type": "number",
              "default": 0.2
            },
            "idle": {
              "type": "number",
              "default": 0.1
            }
          }
        }
      }
    },
    "narrative_structure": {
      "type": "object",
      "description": "叙事结构偏好。当前唯一 outline 模式是 cluster-first。",
      "properties": {
        "outline_mode": {
          "type": "string",
          "enum": [
            "cluster-first"
          ],
          "default": "cluster-first",
          "description": "唯一大纲模式：卷级阶段 + ME/cluster 池 + 只详化当前 active cluster。禁止 strict/hybrid 逐章分支。"
        },
        "major_events_count": {
          "type": "integer",
          "minimum": 5,
          "maximum": 50,
          "default": 13,
          "description": "大势卡 major_events 数量（长篇建议 13-20）"
        },
        "use_throughlines": {
          "type": "boolean",
          "default": true,
          "description": "v21 R2.4 Dramatica 4 线追踪，关闭=单 OS 主线"
        },
        "use_mckee_truby_arc": {
          "type": "boolean",
          "default": true,
          "description": "v21 R3.1 weakness/need vs desire + ghost + moral_argument"
        }
      }
    },
    "character_psychology": {
      "type": "object",
      "description": "Phase 7: 心理/情感系统（v21 R1.3-R1.5 新加，强烈个人偏好）",
      "properties": {
        "stress_threshold_break": {
          "type": "integer",
          "minimum": 3,
          "maximum": 15,
          "default": 8,
          "description": "Mental Break 触发阈值。心理脆弱主角=4-6 / 标准=8 / 钢铁直男=12+"
        },
        "stress_max": {
          "type": "integer",
          "default": 10
        },
        "allowed_mental_break_cards": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "MB_001_黑化",
              "MB_002_酗酒",
              "MB_003_出家",
              "MB_004_封心",
              "MB_005_嗜杀"
            ]
          },
          "default": [
            "MB_001_黑化",
            "MB_002_酗酒",
            "MB_003_出家",
            "MB_004_封心",
            "MB_005_嗜杀"
          ],
          "description": "用户允许的 Mental Break 类型。治愈系可去 005 / 黑深残可全保留"
        },
        "use_active_aspects": {
          "type": "boolean",
          "default": true,
          "description": "v21 R1.4 永久身体/精神烙印"
        },
        "use_fate_dice": {
          "type": "boolean",
          "default": true,
          "description": "v21 R1.4 命运抽签（关闭=AI 自由编 emergent_opp）"
        }
      }
    },
    "interactive_mode": {
      "type": "object",
      "description": "Phase 3: 走向卡 / 全自动模式",
      "properties": {
        "fully_auto": {
          "type": "boolean",
          "default": false,
          "description": "全自动模式：跳过走向卡 + 系统按 narrator 推荐自动选"
        },
        "use_direction_cards": {
          "type": "boolean",
          "default": true,
          "description": "每个 cluster 完成后是否生成/展示走向卡让用户选择下一 cluster brief"
        },
        "direction_cards_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4,
          "default": 3,
          "description": "每次生成几张 cluster 走向候选 brief（默认 3 张）"
        }
      }
    },
    "quality_control": {
      "type": "object",
      "description": "Phase 4-5: 校验严格度",
      "properties": {
        "audit_mode": {
          "type": "string",
          "enum": [
            "strict",
            "advisory",
            "permissive"
          ],
          "default": "advisory",
          "description": "strict=全 hard_gate 严卡 / advisory=顾问制（默认）/ permissive=宽容（快速出稿）"
        },
        "validator_repair_max_rounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3
        },
        "judge_consensus_frequency": {
          "type": "string",
          "enum": [
            "每簇",
            "关键簇",
            "每 5 簇",
            "每 10 簇",
            "关闭"
          ],
          "default": "每 10 簇"
        },
        "cross_cluster_scan_intensity": {
          "type": "string",
          "enum": [
            "full_18",
            "core_10",
            "minimal_5",
            "off"
          ],
          "default": "full_18",
          "description": "跨 cluster scanner 跑多少。短篇可减"
        }
      }
    },
    "anti_slop_personal": {
      "type": "object",
      "description": "Phase 9: 个性化反套话",
      "properties": {
        "user_banned_words": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "用户额外讨厌的词（追加到系统 anti-slop 词典）"
        },
        "user_preferred_phrases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "用户喜欢的句式/词（鼓励 writer 多用）"
        },
        "voice_strictness": {
          "type": "string",
          "enum": [
            "lenient",
            "standard",
            "strict"
          ],
          "default": "standard"
        }
      }
    },
    "advanced": {
      "type": "object",
      "description": "高级用户字段（向导跳过，default 通常 OK）",
      "properties": {
        "git_auto_commit": {
          "type": "boolean",
          "default": true
        },
        "manifest_compression": {
          "type": "boolean",
          "default": true
        },
        "research_first": {
          "type": "boolean",
          "default": true
        },
        "session_memory_enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "narrative_style": {
      "type": "object",
      "description": "叙事风格基础；outline 开工前必须由用户确认",
      "required": [
        "pov"
      ],
      "properties": {
        "pov": {
          "type": "string",
          "enum": [
            "first_person",
            "third_person_limited",
            "third_person_omniscient",
            "multi_pov_third_person"
          ],
          "description": "POV 视角 - 第一人称我 / 第三人称限知（贴单角色） / 全知第三 / 多POV切换"
        },
        "pov_anchor_character": {
          "type": "string",
          "description": "third_person_limited 时绑定的角色（如主角名）"
        },
        "tense": {
          "type": "string",
          "enum": [
            "past",
            "present"
          ],
          "default": "past",
          "description": "时态 - 中文网文默认过去时"
        },
        "narrator_voice": {
          "type": "string",
          "enum": [
            "neutral",
            "ironic",
            "philosophical",
            "intimate"
          ],
          "default": "neutral",
          "description": "叙事者声音色调"
        }
      }
    }
  },
  "$defs": {
    "workflow_preference_entry": {
      "type": "object",
      "description": "workflow_preferences[] 的单条目（key/value 偏好）。outline 写入 cluster-first 链路所需的 cluster_density_profile / writer_mode / rhythm_profile。",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "enum": [
            "cluster_density_profile",
            "writer_mode",
            "rhythm_profile"
          ],
          "description": "偏好键。当前已知键：cluster_density_profile / writer_mode / rhythm_profile。"
        },
        "value": {
          "description": "偏好值（类型随 key 而定，见下方说明）。"
        },
        "set_at": {
          "type": "string",
          "format": "date-time"
        },
        "user_decided": {
          "type": "boolean",
          "description": "true=用户明确决定 / false=系统默认"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "key": {
                "const": "cluster_density_profile"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "稀疏",
                  "标准",
                  "密集",
                  "混合"
                ],
                "default": "标准",
                "description": "cluster 触发密度偏好，只影响 ME/cluster 池的节奏倾向，不分配章节或卷内配额。"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "writer_mode"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "freestyle"
                ],
                "default": "freestyle",
                "description": "正文 writer 固定 freestyle：不暴露目标章节或目标字数，writer 按 cluster brief 自由发挥，splitter 事后输出章节文件。"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "rhythm_profile"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "紧凑",
                  "标准",
                  "厚重",
                  "混合"
                ],
                "default": "标准",
                "description": "v27 节奏档软提示：splitter 输出层按字数微调章节文件长度（紧凑 3000-4000 / 标准 3000-4500 / 厚重 3500-5000 / 混合）。不参与规划层锁定。"
              }
            }
          }
        }
      ]
    }
  }
}
