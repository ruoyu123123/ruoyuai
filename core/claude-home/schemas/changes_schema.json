{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ruoyuai.cluster-writer-self-eval.v29",
  "title": "Cluster Writer Self-Evaluation",
  "description": "writer 在 cluster 级只产创作自评、豁免与确定性写作遥测；客观状态由 archive 和 cluster_state_delta 承载。",
  "type": "object",
  "additionalProperties": false,
  "required": ["self_eval"],
  "properties": {
    "self_eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waivers"],
      "properties": {
        "applied_style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ending_type": {"type": "string"},
            "applied_rules": {"type": "array", "items": {"type": "string"}}
          }
        },
        "waivers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "reason"],
            "properties": {
              "code": {"type": "string"},
              "reason": {"type": "string", "maxLength": 300}
            }
          }
        },
        "uncertainty_flags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "moves_used": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["character", "move_id", "instances"],
            "properties": {
              "character": {"type": "string"},
              "move_id": {"type": "string", "pattern": "^MV_"},
              "instances": {"type": "integer", "minimum": 1}
            }
          }
        },
        "position_effect_evals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action_summary": {"type": "string"},
              "evaluated_position": {"type": "string", "enum": ["controlled", "risky", "desperate"]},
              "evaluated_effect": {"type": "string", "enum": ["great", "standard", "limited"]},
              "evaluated_reason": {"type": "string"}
            }
          }
        },
        "stress_evaluation_self": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "estimated_stress_change": {"type": "string"},
            "violations_made": {"type": "array", "items": {"type": "string"}},
            "alignments_made": {"type": "array", "items": {"type": "string"}},
            "coping_behaviors_used": {"type": "array", "items": {"type": "string"}}
          }
        },
        "storyteller_alignment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_outcome_followed": {"type": "string", "enum": ["setback", "win", "auto"]},
            "actual_outcome": {"type": "string", "enum": ["setback", "win", "neutral"]},
            "phase_alignment_evidence": {"type": "string"}
          }
        },
        "mckee_truby_alignment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "desire_pursued_this_ch": {"type": "string"},
            "need_glimpsed_this_ch": {"type": "string"},
            "ghost_triggered": {"type": "boolean"},
            "moral_argument_advanced": {"type": "boolean"}
          }
        },
        "offscreen_actions_executed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["character", "action_index", "completed_fully"],
            "properties": {
              "character": {"type": "string"},
              "action_index": {"type": "integer", "minimum": 0},
              "completed_fully": {"type": "boolean"}
            }
          }
        },
        "ecas_metadata": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "cluster_id": {"type": "string", "pattern": "^cluster_[0-9]{3,}$"},
            "writer_mode": {"const": "claude_draft_gemini_polish_v29"},
            "chapter_count_decided_by_splitter": {"const": true},
            "word_count_cjk": {"type": "integer", "minimum": 0},
            "paragraph_count": {"type": "integer", "minimum": 0},
            "polish": {"type": ["array", "object"]}
          }
        }
      }
    }
  }
}
