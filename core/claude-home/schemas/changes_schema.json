{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ruoyuai.cluster-writer-self-eval.v29",
  "title": "Cluster Writer Self-Evaluation",
  "description": "writer 在 cluster 级只产创作自评、豁免与确定性写作遥测；客观状态由 archive 和 cluster_state_delta 承载。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "self_eval"
  ],
  "properties": {
    "self_eval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waivers"
      ],
      "properties": {
        "applied_style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ending_type": {
              "type": "string"
            },
            "applied_rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "opening_type": {
              "type": "string"
            },
            "opening_line": {
              "type": "string"
            },
            "opening_justification": {
              "type": "string"
            },
            "ending_line": {
              "type": "string"
            },
            "ending_justification": {
              "type": "string"
            },
            "transitions_used": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "anchors_hit": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "core_techniques_applied": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "subtext_count": {
              "type": "integer"
            },
            "hooks_count": {
              "type": "integer"
            }
          }
        },
        "waivers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "reason"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        },
        "uncertainty_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "moves_used": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "character",
              "move_id",
              "instances"
            ],
            "properties": {
              "character": {
                "type": "string"
              },
              "move_id": {
                "type": "string",
                "pattern": "^MV_"
              },
              "instances": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "stress_evaluation_self": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "estimated_stress_change": {
              "type": "string"
            },
            "violations_made": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "alignments_made": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "coping_behaviors_used": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "storyteller_alignment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_outcome_followed": {
              "type": "string",
              "enum": [
                "setback",
                "win",
                "auto"
              ]
            },
            "actual_outcome": {
              "type": "string",
              "enum": [
                "setback",
                "win",
                "neutral"
              ]
            },
            "phase_alignment_evidence": {
              "type": "string"
            }
          }
        },
        "offscreen_actions_executed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "character",
              "action_index",
              "completed_fully"
            ],
            "properties": {
              "character": {
                "type": "string"
              },
              "action_index": {
                "type": "integer",
                "minimum": 0
              },
              "completed_fully": {
                "type": "boolean"
              }
            }
          }
        },
        "ecas_metadata": {
          "description": "确定性遥测命名空间：由 gen_writer.py save_output() 写入（novel-writer 只在润色后确定性核修时补 cjk_actual / post_polish_deterministic_fixes）。开放属性——本命名空间无自由文本，字段随确定性脚本演进。",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "cluster_id": {
              "type": "string",
              "pattern": "^cluster_[0-9]{3,}$"
            },
            "writer_mode": {
              "const": "claude_draft_gemini_polish_v29"
            },
            "chapter_count_decided_by_splitter": {
              "const": true
            },
            "ch_start": {
              "type": "integer",
              "minimum": 1
            },
            "ch_range": {
              "type": "string"
            },
            "generated_by": {
              "type": "string"
            },
            "generated_by_profile": {
              "type": "string"
            },
            "generated_by_model": {
              "type": "string"
            },
            "generated_at": {
              "type": "string"
            },
            "cjk_actual": {
              "type": "integer",
              "minimum": 0
            },
            "word_count_cjk": {
              "type": "integer",
              "minimum": 0
            },
            "paragraph_count": {
              "type": "integer",
              "minimum": 0
            },
            "length_telemetry": {
              "type": "object"
            },
            "polish": {
              "type": [
                "array",
                "object"
              ]
            },
            "post_polish_deterministic_fixes": {
              "type": [
                "array",
                "object"
              ]
            }
          }
        },
        "writer_mode": {
          "type": "string"
        },
        "cluster_id": {
          "type": "string"
        },
        "narrative_mode": {
          "type": "string"
        },
        "narrative_pov_mode": {
          "type": "string"
        },
        "scene_count": {
          "type": "integer"
        },
        "claude_draft_cjk": {
          "type": "integer"
        },
        "foreshadowing_planted_surface": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dialogue_telemetry": {
          "description": "对话占比遥测。novel-writer 亲笔阶段填 dialogue_* / external_dialogue_ratio / quoted_inner_ratio / claude_draft_dialogue_ratio（外部引号对话与引号心声分开自评）；polished_* 由 changes_io.sync_cjk_actual 从磁盘终稿确定性回写；quote_guard 由 gen_writer 润色引号占比守恒核查确定性写入。封闭清单——novel-writer.md 逐字对齐。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dialogue_cjk": {
              "type": "integer",
              "minimum": 0
            },
            "dialogue_ratio": {
              "type": "number",
              "minimum": 0
            },
            "external_dialogue_ratio": {
              "type": "number",
              "minimum": 0
            },
            "quoted_inner_ratio": {
              "type": "number",
              "minimum": 0
            },
            "claude_draft_dialogue_ratio": {
              "type": "number",
              "minimum": 0
            },
            "polished_dialogue_cjk": {
              "type": "integer",
              "minimum": 0
            },
            "polished_dialogue_ratio": {
              "type": "number",
              "minimum": 0
            },
            "quote_guard": {
              "description": "gen_writer 段级润色引号占比守恒核查遥测（几段触发/重试/保留 Claude 原段）。",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "scenes_triggered": {
                  "type": "integer",
                  "minimum": 0
                },
                "scenes_retried": {
                  "type": "integer",
                  "minimum": 0
                },
                "scenes_kept_claude": {
                  "type": "integer",
                  "minimum": 0
                },
                "floor_ratio": {
                  "type": "number",
                  "minimum": 0
                },
                "min_abs_drop": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}