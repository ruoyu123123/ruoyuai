# ============================================================
# 若渝AI · gen-model 内置默认配置（分发版 · 非密）
# 🔴 本文件绝无密钥。API key 一律走系统凭据管理器（keyring / Windows DPAPI）。
#    在 GUI 设置页录入你自己的 key —— 绝不写回本文件。
# 加载优先级（gen_model_loader._resolve_api_key）：keyring > os.environ > .env文本(本文件无)。
# active 切换写 %APPDATA%/ruoyuai/user_overrides.env，不改本文件（只读 bundle 资源）。
# 本文件仅在 dev 的 .env 都不存在时（= 分发模式）被 loader 第三级回落加载。
# ============================================================

GEN__pie_xian__MODEL=gemini-3.5-flash
GEN__pie_xian__BASE_URL=https://api.pie-xian.com/v1
GEN__pie_xian__TEMPERATURE=0.7

GEN__deepseek_v4_pro__MODEL=deepseek-v4-pro
GEN__deepseek_v4_pro__BASE_URL=https://pay.kxaug.xyz/v1
GEN__deepseek_v4_pro__TEMPERATURE=0.7

GEN__gemini_pro__MODEL=gemini-3.1-pro
GEN__gemini_pro__BASE_URL=https://superapi.buzz/v1
GEN__gemini_pro__PROTOCOL=gemini
GEN__gemini_pro__TEMPERATURE=0.8
GEN__gemini_pro__MAX_TOKENS=65536

GEN__gemini_flash__MODEL=gemini-3.5-flash
GEN__gemini_flash__BASE_URL=https://api.pie-xian.com/v1
GEN__gemini_flash__TEMPERATURE=0.8
GEN__gemini_flash__MAX_TOKENS=65536

GEN__gemini_pro_preview__MODEL=gemini-3.1-pro-preview
GEN__gemini_pro_preview__BASE_URL=https://api.pie-xian.com/v1
GEN__gemini_pro_preview__TEMPERATURE=1.0
GEN__gemini_pro_preview__MAX_TOKENS=65536
GEN__gemini_pro_preview__THINKING_LEVEL=LOW

GEN_MODEL_ACTIVE=gemini_pro_preview
GEN_MODEL_FALLBACK_CHAIN=gemini_flash
