{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/pretooluse_agent_gate.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/pretooluse_step_research.py\""
          },
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/pretooluse_subsystems_gate.py\""
          },
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/pretooluse_plan_step_anti_skip.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/pretooluse_chapter_edit_gate.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/posttooluse_translate.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/posttooluse_plan_check.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/posttooluse_step_reflection.py\""
          },
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/posttooluse_runtime_monitor.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/sessionstart_recall.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/stop_session_memory.py\""
          }
        ]
      }
    ]
  }
}
