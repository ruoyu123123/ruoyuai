{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/pretooluse_agent_gate.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/pretooluse_step_research.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/pretooluse_subsystems_gate.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/pretooluse_plan_step_anti_skip.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/pretooluse_chapter_edit_gate.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/posttooluse_translate.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/posttooluse_plan_check.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/posttooluse_step_reflection.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/posttooluse_runtime_monitor.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/sessionstart_recall.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/core/claude-home/hooks/stop_session_memory.py\""
          }
        ]
      }
    ]
  },
  "_doc": "Claude Code 项目级 hooks 注册。v23.13 新增：PreToolUse:Bash → pretooluse_subsystems_gate（新书全系统强制开启 / outline plan end 前检测 34 个必建 JSON，缺即 exit 2）。v22.gov：PreToolUse:Bash → pretooluse_step_research（强制 plan-step 前查 research_cache）+ PostToolUse:Bash → posttooluse_step_reflection（步骤后强制反思）。原有：PreToolUse:Agent gate / Write|Edit plan_check / SessionStart recall / Stop session_memory。hook 命令用 $CLAUDE_PROJECT_DIR 自适应项目根。所有新 hook 防御性 exit 0（异常放行，不破坏主流程）。"
}
